```gitignore
# Compiled Python files
*.pyc
__pycache__/

# Virtual environments
.venv/
venv/
env/

# Build/dist directories
build/
dist/
*.egg-info/

# Logs
*.log

# Environment files
.env
.env.local
*.env.*

# Coverage reports
.coverage
coverage/
htmlcov/

# Pytest cache
.pytest_cache/

# MyPy cache
.mypy_cache/

# Editor files
.vscode/
.idea/
*.swp
*.swo
*.tmp

# OS files
.DS_Store
Thumbs.db
```